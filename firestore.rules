rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profils : lisibles par les joueurs connectés, modifiables uniquement par leur propriétaire
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Parties terminées : enregistrées une seule fois par un participant, jamais modifiées ensuite
    match /games/{gid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.uids;
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }
  }
}
